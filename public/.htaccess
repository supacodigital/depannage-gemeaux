# Dépannage Gémeaux — configuration Apache (OVH)
# Site statique généré par Next.js (`npm run build` → dossier out/).
# Ce fichier est copié automatiquement à la racine de out/.

# Pas de négociation de contenu (sinon /tarifs pouvait renvoyer une image tarifs.webp),
# pas de listing de dossiers.
Options -MultiViews -Indexes
DirectoryIndex index.html

# Next.js génère tarifs.html ET un dossier tarifs/ (données de navigation).
# Sans cette ligne, Apache redirigerait /tarifs vers /tarifs/.
DirectorySlash Off

ErrorDocument 404 /404.html
AddCharset UTF-8 .html .txt .xml .css .js .json

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Adresse unique : www -> sans www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2. Adresse unique : http -> https
  # Chez OVH, le HTTPS est géré en amont : la condition sur le port (règle recommandée par OVH)
  # évite une boucle de redirection si %{HTTPS} n'est pas renseigné.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{SERVER_PORT} ^80$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 3. Anciennes adresses
  RewriteRule ^electricite/?$ https://depannage-gemeaux.fr/ [R=301,L]
  RewriteRule ^CGVavril2026\.pdf$ https://depannage-gemeaux.fr/cgv.pdf [R=301,L]

  # 4. Adresse unique : pas de slash final (/tarifs/ -> /tarifs) ni d'extension (/tarifs.html -> /tarifs)
  RewriteRule ^(.+)/$ https://depannage-gemeaux.fr/$1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
  RewriteRule ^ https://depannage-gemeaux.fr/ [R=301,L]
  # (sauf le fichier de vérification Google Search Console, qui doit répondre tel quel)
  RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?]
  RewriteRule ^ https://depannage-gemeaux.fr/%1 [R=301,L]

  # 5. Pages : /tarifs est servi par tarifs.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Pages et données de navigation : toujours revalidées, les mises à jour sont visibles immédiatement.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Images et documents
  <FilesMatch "\.(webp|jpg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Fichiers du build Next.js (nom avec empreinte) : mis en cache un an.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
