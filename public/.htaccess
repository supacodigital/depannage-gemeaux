# Dépannage Gémeaux — configuration Apache
# À placer à la racine du site (à côté de index.html).

# Désactive la négociation de contenu : sans ça, /tarifs renvoie l'image tarifs.webp
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Adresse unique : www -> sans www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2. Adresse unique : http -> https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 3. Ancienne page Électricité (désactivée) -> accueil
  RewriteRule ^electricite/?$ https://depannage-gemeaux.fr/ [R=301,L]

  # 4. Application React : toute URL qui n'est pas un fichier réel est servie par index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Fichiers générés par le build (nom contenant un hash) : cache long
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html : toujours revalidé, pour que les mises à jour soient visibles tout de suite
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
